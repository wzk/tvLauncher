<?xml version="1.0" encoding="utf-8"?>
<!-- TV 桌面主界面：全屏背景图 + 标题栏 + 应用网格 + 两层遮罩 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏待机/等待背景图：优先加载自定义图片，回退内置默认背景 -->
    <ImageView
        android:id="@+id/iv_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wallpaper_default" />

    <!-- 启动等待画面渲染层（WebView 在代码中创建并加入此容器）：
         部分老设备 BitmapFactory 解码器损坏，WebView 使用 Chromium 自带的
         图像解码引擎，完全独立于系统解码器。运行时创建 + try-catch 包裹，
         避免老设备/精简 ROM 上 WebView 初始化崩溃导致整个桌面无法打开 -->
    <FrameLayout
        android:id="@+id/wv_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 桌面主内容（标题栏 + 应用网格）：等待自动启动期间会整体隐藏，仅显示背景图 -->
    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏：应用名 + 系统设置快捷入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingTop="20dp"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_open_settings"
                style="@style/TvButton"
                android:text="@string/btn_open_settings" />
        </LinearLayout>

        <!-- 应用网格：支持遥控器 D-Pad 聚焦高亮 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="28dp"
            android:paddingTop="8dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</FrameLayout>
