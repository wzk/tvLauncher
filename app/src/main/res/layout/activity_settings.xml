<?xml version="1.0" encoding="utf-8"?>
<!-- 设置界面：默认启动应用 / 自定义背景图 / 打开系统设置 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 默认启动应用 -->
        <LinearLayout
            android:id="@+id/row_default_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_focusable_item"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_default_app_label"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_default_app_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_clear_default"
            style="@style/TvButton"
            android:layout_marginTop="10dp"
            android:text="@string/settings_clear_default"
            android:visibility="gone" />

        <!-- 自定义背景图 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_custom_bg_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bg_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_pick_image"
                style="@style/TvButton"
                android:layout_marginEnd="10dp"
                android:text="@string/settings_bg_pick" />

            <TextView
                android:id="@+id/btn_input_path"
                style="@style/TvButton"
                android:layout_marginEnd="10dp"
                android:text="@string/settings_bg_input" />

            <TextView
                android:id="@+id/btn_preview"
                style="@style/TvButton"
                android:layout_marginEnd="10dp"
                android:text="@string/settings_bg_preview" />

            <TextView
                android:id="@+id/btn_clear_bg"
                style="@style/TvButton"
                android:text="@string/settings_bg_clear"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_footer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/settings_footer_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
